# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Secure server-side single key to route to any LLM model.
# Never prefix with NEXT_PUBLIC_ or VITE_ so it remains hidden from network inspection.
OPENROUTER_API_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER prefix with NEXT_PUBLIC_ — this key bypasses Row Level Security and must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek API Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Search & Scraping Providers
SERPER_API_KEY=
SERPER_GL=
SERPER_HL=
JINA_API_KEY=

# MCP Configuration (GitHub, Gmail, Google Docs)
GITHUB_TOKEN=
GITHUB_MCP_URL=
GITHUB_MCP_READONLY=
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=
GDOCS_MCP_URL=
GDOCS_MCP_TOKEN=
STATE_SECRET=
ENCRYPTION_SECRET=

# Per-User OAuth 2.0 Credentials (Server-side only, NEVER prefix with NEXT_PUBLIC_)
# GitHub: Register OAuth App at https://github.com/settings/developers
# Callback URL: https://<domain>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google Cloud: Register OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Scopes: gmail.readonly, gmail.send, drive.file, documents
# Callback URL: https://<domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sandbox Execution (Optional for Vercel MicroVM, defaults to Node VM isolation)
VERCEL_OIDC_TOKEN=

# Vercel Deployments API Token (Personal or team API token from vercel.com/account/tokens)
# Distinct from VERCEL_OIDC_TOKEN: VERCEL_TOKEN is used for public REST API deployments to Vercel,
# whereas VERCEL_OIDC_TOKEN is scoped to @vercel/sandbox microVM execution.
VERCEL_TOKEN=
# Optional team ID if deploying under a Vercel team account
VERCEL_TEAM_ID=
